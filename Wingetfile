# Windows counterpart of Brewfile: install with `powershell -ExecutionPolicy Bypass -File .\winget.ps1`.
# Only entries actually wanted on Windows are listed; macOS-only casks and build-time
# libraries from Brewfile are omitted. IDs are exact winget package identifiers
# (`winget search --id <id> -e`). An optional `cmd: "name"` marks the package as already
# installed when that command is on PATH, so tools installed outside winget are not duplicated.
# An optional `override: "args"` is passed to `winget install --override`, i.e. handed to the
# package's own installer in place of the arguments from the winget manifest (used to pick
# Visual Studio workloads; the string must then also request a quiet install itself).
# `psmodule "Name"` entries are PowerShell Gallery modules (Install-Module), see the section at
# the end; winget.ps1 and setup.ps1 both read them. An optional `min: "x.y"` is the minimum
# version: a module below it is treated as missing and gets updated.

## Shell / terminal
# Windows Terminal
winget "Microsoft.WindowsTerminal", cmd: "wt"
# PowerShell 7 (pwsh)
winget "Microsoft.PowerShell", cmd: "pwsh"
# Cross-shell prompt for astronauts
winget "Starship.Starship", cmd: "starship"
# Nerd Font for starship icons (FiraCode Nerd Font is not on winget)
winget "DEVCOM.JetBrainsMonoNerdFont"

## Git / dev tools
# Distributed revision control system (also provides bash, grep, sed, ... and tig:
# there is no winget package for tig, the PowerShell profile's `tig` function runs the
# copy bundled in <git root>\usr\bin)
winget "Git.Git", cmd: "git"
# GitHub command-line tool
winget "GitHub.cli", cmd: "gh"
# Simple terminal UI for git commands
winget "JesseDuffield.lazygit", cmd: "lazygit"
# Lazier way to manage everything docker
winget "JesseDuffield.Lazydocker", cmd: "lazydocker"
# Terminal-based AI coding assistant
winget "Anthropic.ClaudeCode", cmd: "claude"
# Open-source code editor
winget "Microsoft.VisualStudioCode", cmd: "code"

## CLI utilities
# Simple, fast and user-friendly alternative to find
winget "sharkdp.fd", cmd: "fd"
# Search tool like grep and The Silver Searcher
winget "BurntSushi.ripgrep.MSVC", cmd: "rg"
# Command-line fuzzy finder written in Go
winget "junegunn.fzf", cmd: "fzf"
# Lightweight and flexible command-line JSON processor
winget "jqlang.jq", cmd: "jq"
# Shell extension to navigate your filesystem faster
winget "ajeetdsouza.zoxide", cmd: "zoxide"
# Load/unload environment variables based on $PWD
winget "direnv.direnv", cmd: "direnv"
# Internet file retriever
winget "JernejSimoncic.Wget", cmd: "wget"
# Maintained ctags implementation
winget "UniversalCtags.Ctags", cmd: "ctags"
# Unix tools in one binary; the PowerShell profile's `rm` / `find` functions run `busybox rm` / `busybox find`
winget "frippery.busybox-w32", cmd: "busybox"

## Editors
# Ambitious Vim-fork focused on extensibility and agility
winget "Neovim.Neovim", cmd: "nvim"
# Vi 'workalike' with many additional features
winget "vim.vim", cmd: "vim"

## Build tools (nvim-treesitter compiles parsers, so it needs a C compiler and the tree-sitter CLI)
# GNU compiler collection (WinLibs standalone MinGW-w64 build, POSIX threads, UCRT runtime)
winget "BrechtSanders.WinLibs.POSIX.UCRT", cmd: "gcc"
# Incremental parsing system for programming tools (CLI)
winget "tree-sitter.tree-sitter-cli", cmd: "tree-sitter"

## IDE
# Visual Studio Community 2026 (free edition). The winget manifest alone installs the bare
# shell with no workloads, so the override picks "Desktop development with C++" (MSVC, Windows
# SDK, CMake) plus its recommended components. To add workloads: edit the --add list here, or
# open Visual Studio Installer > Modify; component IDs are listed at
# https://learn.microsoft.com/visualstudio/install/workload-component-id-vs-community
# --wait is needed so winget (and this script) blocks until the install actually finishes.
winget "Microsoft.VisualStudio.Community", override: "--quiet --wait --norestart --add Microsoft.VisualStudio.Workload.NativeDesktop --includeRecommended"

