## PowerShell modules (PowerShell Gallery, installed with Install-Module -Scope CurrentUser)
# Windows PowerShell 5.1 and pwsh keep separate user module dirs. pwsh also searches the
# Windows PowerShell one, the reverse is not true, so install from Windows PowerShell (or
# from both shells via setup.ps1) to cover both.
# fzf key bindings for PSReadLine: Ctrl+r history search, Ctrl+t file picker (needs junegunn.fzf)
psmodule "PSFzf"
# git tab completion (the prompt itself is Starship)
psmodule "posh-git"
# Windows PowerShell 5.1 ships PSReadLine 2.0.0, which counts as "installed", but the profile's
# inline history prediction needs 2.1+, hence the minimum version (pwsh already has a newer one)
psmodule "PSReadLine", min: "2.1"
