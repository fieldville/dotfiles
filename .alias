export PGDATA=/usr/local/var/postgres

alias iostat_d='iostat -d'
alias iostat_c='iostat -c'
alias Psql='psql format56 -U postgres'
alias cdwork_ios='cd ~/Documents/00_Work/iOS'
alias cdwork='cd ~/Documents/00_Work'
alias cdworkspace='cd ~/Documents/00_Work/workspace'

export PATH=~/tools:$PATH
export PATH=$HOME/.cargo/bin:$PATH

complete -C aws_completer aws
#eval "$(direnv hook bash)"

if [ -f ~/.function.bash ]; then
    . ~/.function.bash
fi

# some more ls aliases
alias ls='ls --color'
alias ll='ls -ltrh'
alias la='ll -A'
alias l='ls'   # plain ls, same as `l` in home/.posh/PowerShell (no -CF markers)
#alias df='df -Th'
alias df='df -h'
alias h='history'
alias dmesg='dmesg -T'
alias grep='grep -I --color --exclude-dir={.git,.svn,HTML} --exclude={\*.pyc\*}'

# aliases for git live in .galias (sourced from .bashrc / .zshrc right after this file)
#alias pip='pip3'
#alias pip='pip3.6'
#alias python='python3'

# also load inputrc (bash only: $SHELL is still bash when zsh runs this file)
if [[ $- =~ i ]]; then
  if [[ -n $BASH_VERSION ]]; then
    DIR=$(cd $(dirname ${BASH_SOURCE[0]}) && pwd)
    bind -f $DIR/.inputrc
  fi
fi

alias fdh="fd --no-ignore-vcs -H -E '.git/'"
alias rgh="rg -."

# alias emacs="emacs -nw"  # disabled: emacs not installed on 26.04
# alias e="emacs"  # disabled: emacs not installed on 26.04

alias vi=nvim
alias view='nvim -R'
alias vimdiff='nvim -d'

# alias cie='conda info -e'  # disabled: conda not installed on 26.04
# alias cee='conda env export'  # disabled: conda not installed on 26.04

alias lg='lazygit'

alias tt='terraform'
alias ttp='terraform plan'
alias tta='terraform apply'
alias ttm='terraform fmt -recursive'
